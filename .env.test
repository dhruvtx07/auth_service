# Isolated test environment — jest loads this over .env (override mode)
NODE_ENV=test
PORT=4001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auth_service_test
DB_DIALECT=mariadb

JWT_ACCESS_SECRET=test_access_secret_only_for_tests_0123456789abcdef
JWT_REFRESH_SECRET=test_refresh_secret_only_for_tests_0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL=http://localhost:5173
MAIL_FROM="Auth Service <no-reply@test.local>"
