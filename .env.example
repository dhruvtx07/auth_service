# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated allowed origins (frontend)
CORS_ORIGIN=http://localhost:5173

# Directory for file logs (app.log / error.log). Relative paths resolve from the
# backend/ folder — absolute paths are used as-is. Default: backend/logs
# LOGS_DIR=storage/logs

# Frontend URL used to build email links
FRONTEND_URL=http://localhost:5173

# ── MariaDB ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=auth_service
DB_DIALECT=mariadb
DB_LOG_QUERIES=false

# ── JWT ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Google OAuth (Google Cloud Console → Credentials) ─
# Authorized redirect URI must be: ${GOOGLE_REDIRECT_URI}
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/oauth/google/callback

# ── Brevo (free 300 emails/day → SMTP & API settings) ─
BREVO_SMTP_USER=your_brevo_login@example.com
BREVO_SMTP_KEY=your_brevo_smtp_key
MAIL_FROM="Auth Service <no-reply@yourdomain.com>"
